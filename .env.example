# ---- SNEAKERX environment ----
# Server
PORT=4000
NODE_ENV=development

# Secret used to sign admin sessions. REQUIRED in production and must be at
# least 32 characters (e.g. `openssl rand -hex 32`). Never commit the real value.
# The short placeholder below deliberately FAILS on production startup until replaced.
JWT_SECRET=2954a9ca072b716c2d023cf020c36494a9ec817158bef6fced87721462673bd1

# Seeded administrator (used only on first database initialisation)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SneakerX@2026

# Database file (SQLite, created automatically)
DATABASE_PATH=./data/sneakerx.db

# Public base URL of the store (used in CORS, sitemap.xml and robots.txt)
PUBLIC_URL=http://localhost:5173

# ---- Optional AI assistant (SERVER ONLY — never prefix with VITE_) ----
# Leave OPENAI_API_KEY empty to use the built-in local rule engine (default).
# When set, the shopping assistant uses the model below; any failure falls back
# to the local rules automatically. The key is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible endpoints work too (e.g. a local proxy or Azure wrapper).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- WhatsApp order notifications (SERVER ONLY — never prefix with VITE_) ----
# Leave the two keys below empty to use the click-to-chat fallback: every new
# order still raises an in-app admin alert with a ready-to-send wa.me message.
# With keys set, the customer gets an automatic order confirmation and the
# admin gets an automatic "order to prepare" alert (WHATSAPP_ADMIN_NUMBER).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_CUSTOMER_NOTIFY=true

# ---- Client (Vite) ----
# WhatsApp business number in international format, digits only.
# Used for the click-to-chat links when Cloud API keys are not configured.
VITE_WHATSAPP_NUMBER=201000000000

# Optional third-party analytics. Leave empty to keep only first-party analytics.
# GA4 / Meta Pixel are loaded ONLY after the visitor accepts the consent banner.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
